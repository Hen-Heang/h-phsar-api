# ============================================================================
# EXAMPLE FILE — copy me, do not edit me in place.
#
#   PowerShell:  Copy-Item application-local.yaml.example application-local.yaml
#   Bash:        cp application-local.yaml.example application-local.yaml
#
# Then fill in YOUR OWN local values below. application-local.yaml is listed in
# .gitignore and will never be committed — this .example file is the only
# version that lives in Git, and it must never contain a real credential.
# ============================================================================

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/h_phsar
    username: your_local_username
    password: your_local_password

  mail:
    # Any real SMTP account works locally. For Gmail you need an "app password",
    # not your normal login password (Google Account -> Security -> App passwords).
    host: smtp.gmail.com
    port: 587
    username: your_email@example.com
    password: your_gmail_app_password

jwt:
  # Any long random string works for local development. Generate one with:
  #   openssl rand -base64 64
  # or (PowerShell, no OpenSSL required):
  #   [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
  secret: replace_with_a_long_random_local_secret_at_least_64_characters

file:
  upload-dir: uploads
