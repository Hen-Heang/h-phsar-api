<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    WHAT IS THIS FILE?
    ══════════════════
    XML Mapper for BuyerOrderRepository.
    Handles all order/cart operations from the buyer's perspective.

    The OrderResultMap here is identical to the one in OrderSupplierMapper.xml —
    it loads the same 13 fields via nested sub-selects.
    We redefine it here because each XML file is independent in MyBatis.
-->

<mapper namespace="com.henheang.hphsar.repository.BuyerOrderRepository">

    <!--
        RESULT MAP — ProductOrder
        ══════════════════════════
    -->
    <resultMap id="ProductOrderResultMap" type="com.henheang.hphsar.model.product.ProductOrder">
        <id     property="productId"   column="productId"/>
        <result property="productName" column="productName"/>
        <result property="image"       column="image"/>
        <result property="inStock"     column="inStock"/>
        <result property="qty"         column="qty"/>
        <result property="unitPrice"   column="unitPrice"/>
        <result property="subTotal"    column="subTotal"/>
    </resultMap>

    <!--
        RESULT MAP — CartSummery
        ═════════════════════════
    -->
    <resultMap id="CartSummeryResultMap" type="com.henheang.hphsar.model.Cart.CartSummery">
        <id     property="id"         column="id"/>
        <result property="storeId"    column="storeId"/>
        <result property="storeName"  column="storeName"/>
        <result property="storeImage" column="storeImage"/>
        <result property="total"      column="total"/>
    </resultMap>

    <!--
        RESULT MAP — Order (with nested sub-selects for all display data)
        ══════════════════════════════════════════════════════════════════
        Same structure as OrderSupplierMapper.xml — see that file for explanation.
    -->
    <resultMap id="OrderResultMap" type="com.henheang.hphsar.model.order.Order">
        <id     property="id"         column="id"/>
        <result property="storeId"    column="storeId"/>
        <result property="buyerId" column="buyerId"/>
        <result property="date"       column="date"/>

        <!-- Buyer info -->
        <association property="name"
                     column="buyerId"
                     select="com.henheang.hphsar.repository.BuyerProfileRepository.getBuyerNameById"/>
        <association property="address"
                     column="buyerId"
                     select="com.henheang.hphsar.repository.BuyerProfileRepository.getBuyerAddressById"/>
        <association property="buyerImage"
                     column="buyerId"
                     select="com.henheang.hphsar.repository.BuyerProfileRepository.getBuyerImageById"/>
        <association property="buyerPhone"
                     column="buyerId"
                     select="com.henheang.hphsar.repository.BuyerProfileRepository.getBuyerPhoneById"/>
        <association property="buyerEmail"
                     column="buyerId"
                     select="com.henheang.hphsar.repository.BuyerProfileRepository.getBuyerEmailById"/>

        <!-- Store info -->
        <association property="storeImage"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getStoreImageById"/>
        <association property="storeName"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getStoreNameById"/>
        <association property="storeAddress"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getStoreAddressById"/>
        <association property="storePrimaryPhone"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getStorePrimaryPhoneById"/>
        <association property="storeEmail"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getStoreEmailByStoreId"/>

        <!-- Order aggregates -->
        <association property="total"
                     column="id"
                     select="com.henheang.hphsar.repository.SupplierOrderRepository.getTotalOrderAmount"/>
        <association property="status"
                     column="status_id"
                     select="com.henheang.hphsar.repository.SupplierOrderRepository.getStatusByStatusId"/>

        <!-- List of additional phone numbers -->
        <collection  property="storeAdditionalPhone"
                     column="storeId"
                     select="com.henheang.hphsar.repository.StoreRepository.getAdditionalPhone"/>
    </resultMap>

    <!-- ─── SQL FRAGMENTS ────────────────────────────────────────────────────── -->

    <sql id="selectOrderBase">
        SELECT id, store_id AS storeId, buyer_account_id AS buyerId, created_date AS date, status_id
        FROM tb_order
    </sql>

    <sql id="orderByDate">
        ORDER BY created_date
        <choose>
            <when test="sort != null and sort.equalsIgnoreCase('asc')">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
    </sql>

    <sql id="paginate">
        LIMIT #{pageSize} OFFSET #{pageSize} * (#{pageNumber} - 1)
    </sql>

    <!-- ─── HELPER: get single order by id ───────────────────────────────────── -->

    <select id="getOrderByOrderId" resultMap="OrderResultMap">
        SELECT id,
               store_id             AS storeId,
               buyer_account_id AS buyerId,
               created_date        AS date,
               status_id
        FROM tb_order WHERE id = #{id}
    </select>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CART OPERATIONS
         ═══════════════════════════════════════════════════════════════════════
         status_id = 9 → cart (not yet submitted)
         status_id = 8 → draft (saved for later)
    -->

    <select id="checkForCart" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order
                      WHERE store_id = #{storeId} AND buyer_account_id = #{buyerId} AND status_id = 9)
    </select>

    <!-- Step 3C fix: added "AND id != #{excludeOrderId}" — without it, this always
         matched the draft being submitted against itself (its own status is one of
         the ones being checked for), so submitting ANY draft always hit this
         "conflict", making draft submission permanently unreachable. -->
    <select id="checkForCartOrPending" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order
                      WHERE store_id = #{storeId} AND buyer_account_id = #{buyerId} AND status_id IN (8, 9)
                        AND id != #{excludeOrderId})
    </select>

    <select id="createCart" resultType="int">
        INSERT INTO tb_order VALUES (DEFAULT, #{buyerId}, #{storeId}, 9, DEFAULT, DEFAULT) RETURNING id
    </select>

    <select id="getOrderIdByStoreIdAndBuyerId" resultType="int">
        SELECT id FROM tb_order
        WHERE buyer_account_id = #{buyerId} AND store_id = #{storeId} AND status_id = 9
    </select>

    <select id="getUserCartId" resultType="int">
        SELECT id FROM tb_order WHERE buyer_account_id = #{buyerId} AND status_id = 9
    </select>

    <select id="getStoreIdByOrderId" resultType="int">
        SELECT store_id FROM tb_order WHERE id = #{cartId}
    </select>

    <select id="isCartExist" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order WHERE id = #{orderId} AND status_id = 9)
    </select>

    <select id="checkForAnyCart" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order WHERE status_id = 9 AND buyer_account_id = #{currentUserId})
    </select>

    <select id="checkForCartInOtherStore" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order
                      WHERE status_id = 9 AND buyer_account_id = #{buyerId} AND store_id != #{storeId})
    </select>

    <select id="getAllCarts" resultMap="CartSummeryResultMap">
        SELECT id,
               store_id AS storeId,
               (SELECT name FROM tb_store WHERE id = tb_order.store_id) AS storeName,
               (SELECT banner_image FROM tb_store WHERE id = tb_order.store_id) AS storeImage,
               (SELECT SUM(unit_price) FROM tb_order_detail WHERE order_id = tb_order.id) AS total
        FROM tb_order
        WHERE status_id = 9 AND buyer_account_id = #{currentUserId}
    </select>

    <!-- ─── CART ITEMS ──────────────────────────────────────────────────────── -->

    <select id="checkStock" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_store_product_detail WHERE id = #{productId} AND qty >= #{qty})
    </select>

    <select id="getProductPrice" resultType="double">
        SELECT price FROM tb_store_product_detail WHERE id = #{productId}
    </select>

    <select id="addProductToCart" resultType="String">
        INSERT INTO tb_order_detail(id, order_id, qty, unit_price, store_product_id)
        VALUES (DEFAULT, #{orderId}, #{qty}, #{price}, #{storeProductId})
        RETURNING 1
    </select>

    <select id="getProductFromCart" resultMap="ProductOrderResultMap">
        SELECT s.id                                                  AS productId,
               (SELECT name FROM tb_product WHERE id = s.product_id) AS productName,
               s.image,
               s.qty                                                 AS inStock,
               o.qty                                                 AS qty,
               s.price                                               AS unitPrice,
               (o.qty * o.unit_price)                                AS subTotal
        FROM tb_order_detail o
                 JOIN tb_store_product_detail s ON s.id = o.store_product_id
        WHERE o.order_id = #{orderId} AND o.store_product_id = #{storeProductId}
    </select>

    <select id="productIsInCart" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order_detail WHERE store_product_id = #{storeProductId} AND order_id = #{orderId})
    </select>

    <select id="updateProductQtyFromCart" resultType="String">
        UPDATE tb_order_detail
        SET qty = #{qty}, unit_price = #{price}
        WHERE order_id = #{orderId} AND store_product_id = #{storeProductId}
        RETURNING 1
    </select>

    <select id="removeProductFromCart" resultType="String">
        DELETE FROM tb_order_detail
        WHERE store_product_id = #{storeProductId} AND order_id = #{orderId}
        RETURNING 1
    </select>

    <select id="getTotalProduct" resultType="int">
        SELECT count(*) FROM tb_order_detail WHERE order_id = #{orderId}
    </select>

    <!-- ─── VIEW CART PRODUCTS (paginated) ───────────────────────────────────── -->

    <select id="getProductOrderByOrderId" resultMap="ProductOrderResultMap">
        SELECT s.id                                                  AS productId,
               (SELECT name FROM tb_product WHERE id = s.product_id) AS productName,
               s.image,
               s.qty                                                 AS inStock,
               o.qty                                                 AS qty,
               s.price                                               AS unitPrice,
               (o.qty * o.unit_price)                                AS subTotal
        FROM tb_order_detail o
                 JOIN tb_store_product_detail s ON s.id = o.store_product_id
        WHERE o.order_id = #{orderId}
        LIMIT #{pageSize}
        OFFSET #{pageSize} * (#{pageNumber} - 1)
    </select>

    <!-- ─── CART STATUS TRANSITIONS ──────────────────────────────────────────── -->

    <select id="cancelCart" resultType="String">
        DELETE FROM tb_order WHERE id = #{orderId} AND status_id = 9 RETURNING 1
    </select>

    <!-- ═══════════════════════════════════════════════════════════════════════
         ORDER ACTIVITIES (buyer's order list)
         ═══════════════════════════════════════════════════════════════════════
         Step 3C status ids: 1=PENDING, 2=PROCESSING, 3=DISPATCHED, 6=COMPLETED,
         7=CANCELLED, 10=REJECTED — every state after submission. ids 4/5 retired.
    -->

    <select id="getUserOrderActivities" resultMap="OrderResultMap">
        <include refid="selectOrderBase"/>
        WHERE buyer_account_id = #{buyerId} AND status_id IN (1, 2, 3, 6, 7, 10)
        <include refid="orderByDate"/>
        <include refid="paginate"/>
    </select>

    <select id="getTotalOrder" resultType="int">
        SELECT count(*) FROM tb_order
        WHERE buyer_account_id = #{buyerId} AND status_id IN (1, 2, 3, 6, 7, 10)
    </select>

    <!-- ─── ORDER STATUS CHECKS ───────────────────────────────────────────────── -->

    <select id="checkOrderExist" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order WHERE id = #{id} AND status_id IN (1, 2, 3, 6, 7, 10))
    </select>

    <!-- Ownership-scoped existence check — prevents one buyer from acting on another buyer's order (IDOR fix). -->
    <select id="checkOrderExistForBuyer" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order
                      WHERE id = #{id} AND buyer_account_id = #{buyerId} AND status_id IN (1, 2, 3, 6, 7, 10))
    </select>

    <!-- Same ownership scoping, restricted to the buyer-cancellable states (1=PENDING, 8=DRAFT). -->
    <select id="checkOrderExistForBuyerCancellable" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order
                      WHERE id = #{id} AND buyer_account_id = #{buyerId} AND status_id IN (1, 8))
    </select>

    <!-- Fixed (Step 3C): was status_id = 5, a dead id nothing ever wrote — the
         invoice view was permanently unreachable. COMPLETED is id 6. -->
    <select id="checkOrderIsComplete" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order WHERE id = #{id} AND status_id = 6)
    </select>

    <select id="checkForDispatchingOrder" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_order WHERE buyer_account_id = #{currentUserId} AND status_id = 3 AND id = #{id})
    </select>

    <!-- ─── DELETE ORDER / DETAILS ────────────────────────────────────────────── -->

    <select id="deleteOrderDetail" resultType="String">
        DELETE FROM tb_order_detail WHERE order_id = #{orderId} RETURNING 1
    </select>

    <select id="deleteOrder" resultType="String">
        DELETE FROM tb_order WHERE id = #{orderId} RETURNING 1
    </select>

    <!-- ─── MISC HELPERS ──────────────────────────────────────────────────────── -->

    <select id="checkUserInfo" resultType="boolean">
        SELECT EXISTS(SELECT * FROM tb_buyer_info WHERE buyer_account_id = #{buyerId})
    </select>

    <select id="getStoreProductId" resultType="int">
        SELECT id FROM tb_store_product_detail WHERE store_id = #{storeId} AND id = #{productId}
    </select>

</mapper>