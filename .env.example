# ============================================================================
# EXAMPLE FILE — copy me, do not edit me in place.
#
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# Then fill in real local values in your own .env. .env is listed in
# .gitignore and will never be committed — only this .example file (which
# contains no real credential) is tracked in Git.
#
# How the app reads these: Spring Boot resolves ${DB_URL}, ${JWT_SECRET}, etc.
# in application.yaml from process environment variables. Whatever tool you
# use to run the app (an IDE run configuration, `java -jar`, Docker, your
# shell) needs to have these set — a .env file by itself does nothing unless
# something loads it into the environment first.
# ============================================================================

SPRING_PROFILES_ACTIVE=local

# --- Database -----------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/h_phsar
DB_USERNAME=replace_me
DB_PASSWORD=replace_me

# --- Mail (SMTP) ----------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me

# --- JWT --------------------------------------------------------------
# Generate a real value locally, e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_value
